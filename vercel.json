{
  "redirects": [
    {
      "source": "/assessment",
      "destination": "https://humantic-online-functional-v2.vercel.app",
      "permanent": false
    },
    {
      "source": "/assessment/:path*",
      "destination": "https://humantic-online-functional-v2.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/experience",
      "destination": "/experience/index.html"
    },
    {
      "source": "/amex-proposal",
      "destination": "/amex-proposal/index.html"
    },
    {
      "source": "/game-on-kits",
      "destination": "/game-on-kits/index.html"
    },
    {
      "source": "/((?!experience|amex-proposal|game-on-kits).*)",
      "destination": "/index.html"
    }
  ]
}
